// ═══════════════════════════════════════════════════════════
// GÉNÉRATEUR D'ARTICLES DYNAMIQUES
// ═══════════════════════════════════════════════════════════

function getArticlesForSite(siteName) {
  const baseArticles = REAL_ARTICLES_DATABASE[siteName] || [];
  
  // Randomiser l'ordre et ajouter timestamp
  return baseArticles
    .sort(() => Math.random() - 0.5)
    .map((article, index) => ({
      id: `${siteName}_${Date.now()}_${index}`,
      title: article.title,
      excerpt: article.excerpt,
      link: article.url,
      image: CATEGORY_IMAGES[article.category] || CATEGORY_IMAGES['ACTUALITÉ'],
      category: article.category,
      source: siteName,
      timestamp: new Date(Date.now() - Math.random() * 86400000).toISOString(), // Aléatoire dans les dernières 24h
      readTime: `${Math.floor(Math.random() * 5) + 2} min`
    }));
}

// ═══════════════════════════════════════════════════════════
// ROUTES API
// ═══════════════════════════════════════════════════════════

app.get('/', (req, res) => {
  res.json({
    message: '🦁 API Samba IA - News Guinéennes en Temps Réel',
    version: '2.0.0 - BRUTAL MODE',
    status: 'OPERATIONAL ✅',
    endpoints: {
      'GET /api/news/:site': 'Articles d\'un site spécifique',
      'GET /api/news/all': 'Tous les articles agrégés',
      'GET /api/discover': 'Thèmes découverte pour l\'app',
      'GET /api/refresh': 'Actualiser la base de données'
    },
    sites: Object.keys(REAL_ARTICLES_DATABASE),
    total_articles: Object.values(REAL_ARTICLES_DATABASE).flat().length
  });
});

// Route : Un site spécifique
app.get('/api/news/:site', (req, res) => {
  const { site } = req.params;
  
  if (!REAL_ARTICLES_DATABASE[site]) {
    return res.status(404).json({
      success: false,
      error: `Site '${site}' non trouvé. Sites disponibles: ${Object.keys(REAL_ARTICLES_DATABASE).join(', ')}`
    });
  }

  const articles = getArticlesForSite(site);
  
  res.json({
    success: true,
    site,
    count: articles.length,
    articles,
    lastUpdate: new Date().toISOString()
  });
});

// Route : Tous les sites
app.get('/api/news/all', (req, res) => {
  const allArticles = Object.keys(REAL_ARTICLES_DATABASE)
    .map(site => getArticlesForSite(site))
    .flat()
    .sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

  res.json({
    success: true,
    total: allArticles.length,
    sources: Object.keys(REAL_ARTICLES_DATABASE),
    articles: allArticles,
    lastUpdate: new Date().toISOString()
  });
});

// Route : Thèmes découverte
app.get('/api/discover', (req, res) => {
  const allArticles = Object.keys(REAL_ARTICLES_DATABASE)
    .map(site => getArticlesForSite(site))
    .flat();

  // Prendre 6 articles aléatoires de différentes catégories
  const categories = [...new Set(allArticles.map(a => a.category))];
  const themes = categories.slice(0, 6).map((cat, i) => {
    const article = allArticles.find(a => a.category === cat) || allArticles[i];
    return {
      id: i + 1,
      title: article.title,
      summary: article.excerpt,
      content: `${article.title}\n\n${article.excerpt}\n\nSource: ${article.source}\nCatégorie: ${article.category}`,
      category: article.category,
      image: article.image,
      url: article.link
    };
  });

  res.json({
    success: true,
    count: themes.length,
    themes
  });
});

// Route : Refresh (simuler une mise à jour)
app.get('/api/refresh', (req, res) => {
  res.json({
    success: true,
    message: 'Base de données actualisée',
    timestamp: new Date().toISOString(),
    total_articles: Object.values(REAL_ARTICLES_DATABASE).flat().length
  });
});

